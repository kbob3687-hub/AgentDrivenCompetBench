# ============================================================
# 复制此文件为 .env 并填入真实值
# 或直接使用 .env.reviewer（已预填密钥）
# ============================================================

# DeepSeek API（所有 Agent 使用）
# 控制台：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Firecrawl API（URL 发现 + 网页采集）
# 控制台：https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-xxxxxxxx

# Langfuse（可观测性，可选 — 没有也能正常运行）
# 注册：https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# 数据库（可选 — 无 PostgreSQL 时自动内存兜底）
POSTGRES_USER=ca_user
POSTGRES_PASSWORD=ca_password
POSTGRES_DB=competitive_analysis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 应用配置
APP_ENV=dev
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=3
DEFAULT_INDUSTRY=saas
