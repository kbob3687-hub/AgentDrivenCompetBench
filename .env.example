# ============================================================
# 复制此文件为 .env 并填入真实值
# ============================================================

# Langfuse Cloud（免费版，注册地址：https://cloud.langfuse.com）
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Claude API（控制台：https://console.anthropic.com）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# 数据库
POSTGRES_USER=ca_user
POSTGRES_PASSWORD=ca_password
POSTGRES_DB=competitive_analysis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis（复用本地容器）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Jina Reader
JINA_READER_BASE=https://r.jina.ai

# DeepSeek（控制台：https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Firecrawl（控制台：https://www.firecrawl.dev）
FIRECRAWL_API_KEY=fc-xxxxxxxx

# 应用配置
APP_ENV=dev
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=3
DEFAULT_INDUSTRY=saas
